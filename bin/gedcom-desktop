#!/bin/sh
# Launcher: runs the desktop app built by `mvn package`, from any directory.
# An optional argument names a GEDCOM file to open.
here=$(cd "$(dirname "$0")/.." && pwd)
jar="$here/desktop/target/gedcom-shell-desktop.jar"
if [ ! -f "$jar" ]; then
  echo "gedcom-desktop: $jar not found; run 'mvn package' in $here first" >&2
  exit 2
fi
if [ -n "$1" ] && [ -e "$1" ]; then
  set -- "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
fi
exec java --enable-native-access=ALL-UNNAMED -jar "$jar" "$@"
