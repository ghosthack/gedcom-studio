<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.ghosthack</groupId>
    <artifactId>gedcom-shell-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gedcom-shell-desktop</artifactId>
  <name>gedcom-shell desktop</name>
  <description>The Swing desktop app: a client of the gedcom-shell daemon</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>6.0.3</junit.version>
    <flatlaf.version>3.7.1</flatlaf.version>
    <main.class>ged.desktop.DesktopApp</main.class>
    <skipUiTests>false</skipUiTests>
  </properties>

  <dependencies>
    <!-- the daemon, its client and the JSON reader; the shaded jar carries the daemon
         too, so DaemonClient.ensure can start one from this same jar -->
    <dependency>
      <groupId>com.github.ghosthack</groupId>
      <artifactId>gedcom-shell</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>gedcom-shell-desktop</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <!-- tests never see the real ~/.gedcom-shell, nor a daemon running there,
               and never open a window -->
          <systemPropertyVariables>
            <gedcom.shell.home>${project.build.directory}/test-home</gedcom.shell.home>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
          <excludedGroups>ui</excludedGroups>
        </configuration>
        <executions>
          <!-- UiTest builds real windows (never shown), so it needs a display:
               on Linux without one, run under xvfb-run, as CI does.
               -DskipUiTests skips it. -->
          <execution>
            <id>ui-tests</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <skip>${skipUiTests}</skip>
              <groups>ui</groups>
              <excludedGroups combine.self="override"/>
              <systemPropertyVariables combine.self="override">
                <gedcom.shell.home>${project.build.directory}/ui-home</gedcom.shell.home>
                <java.awt.headless>false</java.awt.headless>
                <!-- no Dock icon while the tests run on macOS -->
                <apple.awt.UIElement>true</apple.awt.UIElement>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- always rebuild the thin jar, so shade never bundles a stale one -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                  <manifestEntries>
                    <!-- MacAppearance calls the Objective-C runtime through the FFM API;
                         without this, JDK 24+ warns about a restricted method on launch -->
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
